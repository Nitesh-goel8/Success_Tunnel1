# ======================================================================
# SUCCESS TUNNEL ERP - ENVIRONMENT CONFIGURATION
# ======================================================================

# Database Connection
# Production (PostgreSQL / Neon / Supabase):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/successtunnel?schema=public"
# Local development zero-setup alternative:
# DATABASE_URL="file:./prisma/dev.db"

# Authentication & Security
# Generate a secure 32+ character key for production (e.g. openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-for-production"
COOKIE_SECURE="false" # set to true in production HTTPS environments

# Initial Super Admin Seed Credentials
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL="admin@successtunnel.in"
ADMIN_PASSWORD="ChangeMe@Admin2026!"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Success Tunnel ERP"

# Optional Email / SMTP Notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@successtunnel.in"
SMTP_PASS="smtp_password_here"
EMAIL_FROM="Success Tunnel Portal <no-reply@successtunnel.in>"

# Razorpay / Payment Gateway (Optional for Rental Spaces)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
