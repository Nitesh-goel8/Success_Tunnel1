{
  "name": "successtunnel_app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "ts-node --project tsconfig.seed.json tests/erp-portal.test.ts",
    "test:phase-a": "ts-node --project tsconfig.seed.json tests/phase-a-auth.test.ts",
    "test:phase-b": "ts-node --project tsconfig.seed.json tests/phase-b-org.test.ts",
    "test:phase-c": "ts-node --project tsconfig.seed.json tests/phase-c-projects.test.ts",
    "test:phase-d": "ts-node --project tsconfig.seed.json tests/phase-d-crm.test.ts",
    "test:phase-e": "ts-node --project tsconfig.seed.json tests/phase-e-finance.test.ts",
    "test:all": "ts-node --project tsconfig.seed.json tests/erp-portal.test.ts && ts-node --project tsconfig.seed.json tests/phase-a-auth.test.ts && ts-node --project tsconfig.seed.json tests/phase-b-org.test.ts && ts-node --project tsconfig.seed.json tests/phase-c-projects.test.ts && ts-node --project tsconfig.seed.json tests/phase-d-crm.test.ts && ts-node --project tsconfig.seed.json tests/phase-e-finance.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push --skip-generate",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:push:pg": "prisma db push --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "setup": "prisma db push --schema=prisma/schema.sqlite.prisma && ts-node --project tsconfig.seed.json prisma/seed.ts",
    "setup:pg": "prisma db push --schema=prisma/schema.prisma && ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "4.16.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "1.4.0",
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.0",
    "next": "13.4.10",
    "nodemailer": "^9.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "9.0.2",
    "@types/node": "20.4.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "eslint": "8.49.0",
    "eslint-config-next": "^13.4.10",
    "prisma": "4.16.0",
    "ts-node": "10.9.1",
    "typescript": "5.3.3"
  }
}
